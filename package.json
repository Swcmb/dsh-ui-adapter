{
  "name": "@ianwusb/dsh-ui-adapter",
  "version": "0.8.3",
  "description": "Collapse the duplicate DSH \"上下文\" tabs into one, replace dsh-context's sponsor card with a ledger switch, and feed billion-context's authoritative token ledger into dsh-context's tokenUsage projection.",
  "type": "module",
  "main": "lib/index.js",
  "license": "GPL-3.0-or-later",
  "author": "Swcmb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swcmb/dsh-ui-adapter.git"
  },
  "homepage": "https://github.com/Swcmb/dsh-ui-adapter#readme",
  "bugs": {
    "url": "https://github.com/Swcmb/dsh-ui-adapter/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./client-adapter": "./lib/client-adapter.js",
    "./client-session-panel": "./lib/client-session-panel.js",
    "./client-cs-panel-hider": "./lib/client-cs-panel-hider.js",
    "./client-default-sidebar-tab": "./lib/client-default-sidebar-tab.js",
    "./config": "./lib/config.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "COPYING",
    "README.md",
    "NOTICES.md",
    "LICENSE-session-panel",
    "LICENSE-cs-panel-hider",
    "LICENSE-default-sidebar-tab"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  }
}
