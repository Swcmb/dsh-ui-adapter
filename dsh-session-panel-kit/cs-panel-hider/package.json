{
  "name": "@local/dsh-cs-panel-hider",
  "version": "0.1.0",
  "description": "Standalone DSH patch plugin: hide dsh-claude-style's session details rail and its header toggle icon, without touching that plugin.",
  "type": "module",
  "main": "lib/index.mjs",
  "license": "GPL-3.0-or-later",
  "author": "Swcmb",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
